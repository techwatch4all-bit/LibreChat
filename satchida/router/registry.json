{
  "_comment": "Satchida autorouter registry. NO KEYS HERE. Keys: env var (keyEnv) or, on the HQ PC only, read live from the opencode auth store (keyFrom.opencodeAuth). Provider ids match opencode so free-exceptions.json can be shared. revenueSafe=false: ToS does not clearly permit powering paying customers (INFERENCE.md section 3), so only 'internal' traffic is served. retention: none|documented|unknown; unknown never serves privacy.",
  "defaultTraffic": "internal",
  "revenueGate": "off",
  "visionRegex": "vl|vision|omni|gemma-4|qwen3\\.[5-9]|qwen3\\.8|muse|mimo|gpt-6|llama-4|pixtral|gemini|glm-.*v|kimi",
  "freeListFile": "repos/opencode/xdg-config/opencode/free-exceptions.json",
  "freeListSkipRegex": "asr|parakeet|image|lyria|safety|embed|tts|rerank|whisper|lora|abliterated|--ep-",
  "providers": {
    "llama.cpp": {
      "baseURL": "http://127.0.0.1:8080/v1",
      "revenueSafe": true,
      "retention": "none",
      "locality": "local"
    },
    "llama.cpp-8091": {
      "baseURL": "http://127.0.0.1:8091/v1",
      "revenueSafe": true,
      "retention": "none",
      "locality": "local"
    },
    "openrouter": {
      "baseURL": "https://openrouter.ai/api/v1",
      "keyEnv": "OPENROUTER_API_KEY",
      "keyFrom": {
        "opencodeAuth": "openrouter"
      },
      "revenueSafe": false,
      "retention": "documented",
      "discover": {
        "type": "openrouter",
        "mode": ["chat", "work"]
      }
    },
    "opencode": {
      "baseURL": "https://opencode.ai/zen/v1",
      "keyEnv": "OPENCODE_ZEN_API_KEY",
      "keyFrom": {
        "opencodeAuth": "opencode"
      },
      "revenueSafe": false,
      "retention": "unknown",
      "discover": {
        "type": "openai-models",
        "freeNameRegex": "free|bunny",
        "mode": ["chat", "work"]
      }
    },
    "command-code": {
      "baseURL": "https://api.commandcode.ai/provider/v1",
      "keyEnv": "COMMAND_CODE_API_KEY",
