      },
      "day": {
        "default": 6000
      }
    }
  },
  "localGate": {
    "max": 8,
    "maxQueue": 64,
    "waitMs": 45000
  },
  "modePrompts": {
    "style:plan": "PLAN MODE: analyse the request and produce a clear step-by-step plan with risks and open questions. Do not write final code or perform the work yet; end by asking for approval to proceed.",
    "style:build": "BUILD MODE: carry out the task now. Produce the complete deliverable (code, document, or result) following any earlier plan; be concise about explanation.",
    "study": "You are a patient tutor. Explain step by step, check understanding with a short question, adapt to the learner's level, and avoid just giving final answers to homework unless asked."
