  "limits": {
    "_comment": "Per-user and per-client request caps. Overridable per plan later via licence. Counters are in-memory (reset on router restart).",
    "user": {
      "h5": {
        "default": 60,
        "chat": 80,
        "work": 50,
        "study": 60,
        "privacy": 30
      },
      "day": {
        "default": 200,
        "chat": 250,
        "work": 150,
        "study": 200,
        "privacy": 100
